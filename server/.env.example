# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# Port the server listens on (hosting providers set this automatically)
PORT=5000

# MongoDB Atlas connection string (from Atlas > Connect > Drivers)
MONGODB_URI=your_mongodb_connection_string

# Gemini API key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# The URL of your frontend (used for CORS). No trailing slash.
# Local: http://localhost:5173   Production: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Optional
NODE_ENV=development
GEMINI_MODEL=gemini-2.5-flash
